# Copy this file to .env, then set OPENAI_API_KEY. Do not commit .env.
# PowerShell: Copy-Item .env.example .env
OPENAI_API_KEY=

# Live OpenAI setup: one key powers web search, planning, writing, and review.
RESEARCH_PROVIDER_MODE=live
SEARCH_PROVIDER=openai
WRITER_PROVIDER=openai
VERIFIER_PROVIDER=openai
WRITER_MODEL=gpt-6-luna
VERIFIER_MODEL=gpt-6-luna
PRICE_SHEET_PATH=core/price_sheet_openai.json

# Local limits. These values can stay as shipped for an initial test.
MAX_CONCURRENT_RUNS=2
RUN_TIME_FACTOR=1.0
# Review one batch at a time to avoid a burst of GPT-6 Luna requests.
VERIFIER_PARALLEL=1
DAILY_SPEND_ALERT_USD=5
DAILY_SPEND_STOP_USD=8
LOG_DIR=logs
STATE_DIR=state
